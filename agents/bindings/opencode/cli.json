{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "synthwave84"
  },
  "session": {
    "sidebar": "hide"
  },
  "keybinds": {
    "command.palette.show": "alt+p,super+p",
    "input.backspace": "backspace,shift+backspace,ctrl+h",
    "input.move.up": "up,ctrl+p",
    "input.move.down": "down,ctrl+n",
    "input.move.left": "left,ctrl+b",
    "input.move.right": "right,ctrl+f",
    "session.background": "ctrl+shift+b",
    "prompt.history.previous": "up,ctrl+p",
    "prompt.history.next": "down,ctrl+n"
  },
  "plugins": [
    "./herdr-opencode",
    "@prevalentware/opencode-goal-plugin"
  ]
}
