{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "default_agent": "plan",
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "spark", "effect": "allow" },
    { "action": "provider.use", "resource": "opencode", "effect": "allow" }
  ],
  "providers": {
    "spark": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "DGX Spark vLLM",
      "settings": {
        "baseURL": "http://spark-head:8888/v1"
      },
      "models": {
        "GLM-5.3-Flash-EXL3": {
          "name": "GLM-5.3 Flash EXL3 (Spark)",
          "capabilities": {
            "tools": true
          },
          "settings": {
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 500000,
            "output": 65536
          }
        },
        "DeepSeek-v4.1-Flash-EXL3": {
          "name": "DeepSeek V4.1 Flash EXL3 (Spark)",
          "capabilities": {
            "tools": true
          },
          "settings": {
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 600000,
            "output": 65536
          }
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731 (Spark)",
          "capabilities": {
            "tools": true
          },
          "settings": {
            "reasoningEffort": "high"
          },
          "limit": {
            "context": 524288,
            "output": 65536
          }
        },
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash Vision-Exp (Spark)",
          "capabilities": {
            "tools": true
          },
          "settings": {
            "reasoningEffort": "high"
          },
          "limit": {
            "context": 524288,
            "output": 65536
          }
        },
        "qwen3.8-flash-next": {
          "name": "Qwen3.8 Flash-Next NVFP4 (Spark)",
          "capabilities": {
            "tools": true
          },
          "settings": {
            "reasoningEffort": "xhigh"
          },
          "limit": {
            "context": 524288,
            "output": 65536
          }
        }
      }
    }
  },
  "update": "disable"
}
