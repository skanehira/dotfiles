{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "default_agent": "plan",
  "provider": {
    "spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DGX Spark vLLM",
      "options": {
        "baseURL": "http://spark-head.local:8888/v1"
      },
      "models": {
        "GLM-5.3-Flash-EXL3": {
          "name": "GLM-5.3 Flash EXL3 (Spark)",
          "reasoning": true,
          "tool_call": true,
          "options": {
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 500000,
            "output": 65536
          }
        },
        "DeepSeek-v4.1-Flash-EXL3": {
          "name": "DeepSeek V4.1 Flash EXL3 (Spark)",
          "reasoning": true,
          "tool_call": true,
          "options": {
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 600000,
            "output": 65536
          }
        },
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash Vision-Exp (Spark)",
          "reasoning": true,
          "tool_call": true,
          "options": {
            "reasoningEffort": "high"
          },
          "limit": {
            "context": 524288,
            "output": 65536
          }
        },
        "qwen3.8-flash-next": {
          "name": "Qwen3.8 Flash-Next NVFP4 (Spark)",
          "reasoning": true,
          "tool_call": true,
          "options": {
            "reasoningEffort": "xhigh"
          },
          "limit": {
            "context": 524288,
            "output": 65536
          }
        }
      }
    }
  },
  "autoupdate": false
}
