{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-fable-5-1[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_MODEL": "opusplan",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_COMMIT_REVIEW": "0"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(rg *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(pwd)",
      "Bash(awk *)",
      "Bash(python3 *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh *)",
      "WebFetch(domain:*)",
      "mcp__chrome-devtools"
    ],
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "fallbackModel": [
    "claude-opus-4-8",
    "sonnet"
  ],
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/skanehira/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $GHQ_ROOT/github.com/skanehira/dotfiles/agents/scripts/statusline-command.sh"
  },
  "enabledPlugins": {
    "archify@misty-lantern": true,
    "bank-ledger-transcribe@misty-lantern": true,
    "claude-code-setup@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": true,
    "codex@openai-codex": true,
    "compact-plus@compact-plus-local": true,
    "deploy-on-aws@agent-plugins-for-aws": false,
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "postgres-best-practices@supabase-agent-skills": false,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "slide-plugin@slide-plugin": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "claude-security@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "session-brief@claude-session-brief": true
  },
  "extraKnownMarketplaces": {
    "agent-plugins-for-aws": {
      "source": {
        "source": "github",
        "repo": "awslabs/agent-plugins"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "compact-plus-local": {
      "source": {
        "source": "github",
        "repo": "u-ichi/compact-plus"
      }
    },
    "misty-lantern": {
      "source": {
        "source": "github",
        "repo": "skanehira/misty-lantern"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "slide-plugin": {
      "source": {
        "source": "github",
        "repo": "skanehira/slide-plugin"
      }
    },
    "supabase-agent-skills": {
      "source": {
        "source": "github",
        "repo": "supabase/agent-skills"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "claude-session-brief": {
      "source": {
        "source": "github",
        "repo": "skanehira/claude-session-brief"
      }
    }
  },
  "outputStyle": "concise",
  "language": "Japanese",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "verbose": true,
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
