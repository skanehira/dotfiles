{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gpt-oss-20b-32k": {
          "name": "gpt-oss-20b-32k:latest"
        }
      }
    },
    "spark": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DGX Spark vLLM",
      "options": {
        "baseURL": "{file:~/.config/opencode/spark-base-url}",
        "apiKey": "{file:/tmp/spark.key}"
      },
      "models": {
        "deepseek-v4-flash-vision-exp": {
          "name": "DeepSeek V4 Flash Vision-Exp (Spark)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 524288,
            "output": 65536
          }
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731 (Spark)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 524288,
            "output": 65536
          }
        }
      }
    }
  },
  "autoupdate": false
}
